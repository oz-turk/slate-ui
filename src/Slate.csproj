<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net48, not net7.0-windows: Rhino 7 only hosts .NET Framework plugins.
         Rhino 8 still loads netfx .gha's via its compat runtime, so a single
         net48 target covers both. -->
    <TargetFramework>net48</TargetFramework>
    <Version>0.1.2</Version>
    <AssemblyName>Slate</AssemblyName>
    <RootNamespace>Slate</RootNamespace>
    <TargetExt>.gha</TargetExt>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>11</LangVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <!-- Built against Rhino 7's assemblies (the older baseline) so the same
         .gha loads on both Rhino 7 and Rhino 8. -->
    <Reference Include="Grasshopper">
      <HintPath>C:\Program Files\Rhino 7\Plug-ins\Grasshopper\Grasshopper.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="GH_IO">
      <HintPath>C:\Program Files\Rhino 7\Plug-ins\Grasshopper\GH_IO.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="RhinoCommon">
      <HintPath>C:\Program Files\Rhino 7\System\RhinoCommon.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <!-- Rhino 7 doesn't bundle its own WebView2 Core.dll (only Rhino 8 does),
       so we take Core + WinForms from the NuGet package itself and rely on
       the system Edge WebView2 Evergreen runtime at load time, instead of
       hint-pathing to a Rhino-provided copy. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.1938.49" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <!-- Embed compiled Svelte output -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\**\*" />
  </ItemGroup>

  <Target Name="DeployToGrasshopper" AfterTargets="Build">
    <ItemGroup>
      <!-- Every NuGet-provided DLL next to the .gha (WebView2, System.Text.Json,
           and their own transitive deps like System.Buffers/Memory/Numerics.Vectors).
           Rhino 7 has no fallback source for these — unlike Rhino 8, which apparently
           already provides a compatible System.Text.Json on its own — so a single
           missing one throws a silent FileNotFoundException deep inside a
           JSON-serializing IPC call (capture/reset stop working, no error shown).
           Copy the whole output dir instead of hand-picking files so a future
           PackageReference doesn't quietly reintroduce the same bug. -->
      <DeployAssemblies Include="$(TargetDir)*.dll" />
    </ItemGroup>
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(APPDATA)\Grasshopper\Libraries" />
    <Copy SourceFiles="@(DeployAssemblies)" DestinationFolder="$(APPDATA)\Grasshopper\Libraries" />
    <Copy SourceFiles="$(TargetDir)runtimes\win-x64\native\WebView2Loader.dll"
          DestinationFolder="$(APPDATA)\Grasshopper\Libraries"
          Condition="Exists('$(TargetDir)runtimes\win-x64\native\WebView2Loader.dll')" />
  </Target>

</Project>
